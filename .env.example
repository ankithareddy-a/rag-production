# Redis
REDIS_URL=redis://:yourpassword@localhost:6379
REDIS_PASSWORD=yourpassword

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Embedding model (runs locally via sentence-transformers, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMS=384

# Redis vector index settings
VECTOR_INDEX_NAME=rag_docs
VECTOR_DOC_PREFIX=doc:

# Retrieval settings
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Semantic cache similarity threshold (0.0=loose, 1.0=exact)
CACHE_THRESHOLD=0.90

# API
API_HOST=0.0.0.0
API_PORT=8000
